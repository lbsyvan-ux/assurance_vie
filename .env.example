# ============================================================
#  Modèle de configuration. NE JAMAIS mettre de vraies clés ici.
#  Les vraies valeurs vont dans .env (local) et dans Vercel.
# ============================================================

# ---- FRONT (préfixe VITE_, exposé au navigateur — PAS de secret) ----
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx   # clé publique anon

# ---- SERVEUR (Vercel Functions — SECRET, jamais côté front) ----
# OpenAI : clé PARTAGÉE du cabinet, utilisée par /api/analyze pour toutes
# les analyses. SECRET — ne jamais préfixer VITE_ ni l'exposer au navigateur.
OPENAI_API_KEY=sk-xxx

# Stripe (Dashboard > Developers > API keys, en mode TEST)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx          # fourni à la création du webhook
STRIPE_PRICE_MONTHLY=price_xxx           # tarif 14,99 €/mois (mode TEST)
STRIPE_PRICE_ANNUAL=price_xxx            # tarif 124,99 €/an (mode TEST)

# Supabase côté serveur (Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx     # même valeur que VITE_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=xxx            # SECRET ABSOLU — bypass la RLS

# URL publique de l'app (fallback pour les redirections Stripe)
PUBLIC_APP_URL=https://ton-domaine.vercel.app
